# Logs & Output (Keep folders tracked via .gitkeep, ignore contents)
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep

# Media files and subtitle outputs (Avoid committing large test video/audio)
*.mp4
*.mkv
*.avi
*.mov
*.wav
*.mp3
*.flac
*.aac
*.srt

# Models cache & downloaded weights
models/
.cache/

